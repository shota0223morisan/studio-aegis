# ---- Studio Aegis 設定 ----
# コピーして .env として使います(docker compose / npm start どちらでも読み込まれます)

# アプリにアクセスするときの URL(Spotify のリダイレクト先にも使われます)
#   ローカルのみ:       http://127.0.0.1:8787
#   Tailscale serve:    https://<マシン名>.<tailnet>.ts.net
PUBLIC_URL=http://127.0.0.1:8787
PORT=8787

# ログインパスワード。ネットワーク越しに使うなら必ず設定してください(空ならログインなし)
APP_PASSWORD=

# データ(SQLite と アップロードファイル)の保存先。省略時は ./data
# DATA_DIR=./data

# 1ファイルあたりのアップロード上限 (MB)
MAX_UPLOAD_MB=1024

# Spotify (https://developer.spotify.com/dashboard でアプリ登録)
#   Redirect URI には  <PUBLIC_URL>/api/spotify/callback  を登録
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
