{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studio-aegis",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  // No per-version preview URLs: one public address is enough for a personal app.
  "preview_urls": false,
  "observability": { "enabled": true },

  // Built SPA (npm run build). /api/* always goes to the Worker (incl. the Spotify OAuth
  // callback, which is a browser navigation); other unknown paths fall back to index.html.
  "assets": {
    "directory": "web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Projects, memos, Spotify references, file metadata.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studio-aegis",
      // Filled in by `npm run setup:cloudflare` (or paste the id from `wrangler d1 create studio-aegis`).
      "database_id": "f99d3b75-9a55-4673-ae10-62ddf4290962",
      "migrations_dir": "worker/migrations"
    }
  ],

  // Uploaded audio files and thumbnails.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "studio-aegis-files" }],

  "vars": {
    // Per-file upload limit in MB (uploads are chunked, so this is not bound by the Worker body limit).
    "MAX_UPLOAD_MB": "5120"
  }

  // Secrets (set with `wrangler secret put <NAME>`; for local dev put them in .dev.vars):
  //   APP_PASSWORD            login password (strongly recommended)
  //   SPOTIFY_CLIENT_ID       Spotify app credentials (optional)
  //   SPOTIFY_CLIENT_SECRET
  //   SESSION_SECRET          optional; generated and stored in D1 if absent
  //   SPOTIFY_REDIRECT_URI    optional override; defaults to <request origin>/api/spotify/callback
}
